[user]
    name = Jeffrey Faer
    email = jeffrey.faer@gmail.com
[color]
    ui = auto
[merge]
    tool = meld
[mergetool "meld"]
    trustExitCode = true
[push]
    default = simple
[grep]
    fullName = true
    lineNumber = true
    patternType = extended
[difftool]
    prompt = false
[init]
    defaultBranch = main
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[remote "origin"]
	prune = true

[hook "prune-stale-refspecs"]
    event = post-checkout
    command = ~/git/hooks/prune-stale-refspecs.bash

[include]
    path = ~/git/local.gitconfig
